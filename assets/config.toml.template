# pamem onboarding config template
# Copy this file to config.toml for an XDG agent home, or to .pamem/config.toml for a legacy/Slock workspace anchor.
# An agent home or legacy/Slock workspace activates one profile at a time; alternate role-specific starters live in assets/config-profiles/*.toml.template.
# Managed by a human or an onboarding-authorized profile. Ordinary task agents read it but do not rewrite it directly.

version = 1
default_profile = "onboarding"

[runtime]
# cli = current-task is primary local recovery; slock = task board owns state while workspace notes keep a thin current-task/work-log cache.
mode = "cli"
# Optional stable id for the local agent home. Empty means derive from the configured root path.
agent_id = ""

[runtime.resume]
# Optional runtime-native resume launcher, e.g. ["codex", "resume"].
# Empty means pamem launch --resume falls back to the launcher recorded by pamem launch.
command = []

[memory_repo]
# Default is a machine-level shared memory repo. Bootstrap initializes this path as a git repository. Relative paths are resolved from the agent home or legacy/Slock workspace anchor when an override is needed.
path = "${XDG_DATA_HOME:-$HOME/.local/share}/pamem/memory"
sharing = "shared"
entry_file = "MEMORY.md"

[memory_repo.sync]
# Git-only sync. Empty remote means use the repo's origin remote.
remote = ""
ref = "main"

[memory_repo.git]
# Optional repo-local git author applied to the configured memory repo by install/repair/onboard/launch.
# Leave both empty to use the repo or environment default.
author_name = ""
author_email = ""

[governance]
config_owner = "human"
generated_by = "onboarding"
requires_review_for = [
  "memory_repo",
  "memory_repo.sync",
  "config.toml",
  ".pamem/config.toml",
  "governance/**",
  "shared/**",
  "roles/**"
]

[profiles.onboarding]
role = "onboarding"
description = "Onboarding profile for seeding shared memory and creating new agents."
load = [
  "governance/constitution.md",
  "shared/preferences.md",
  "shared/operating-rules.md",
  "shared/experience.md",
  "roles/onboarding/onboarding.md",
  "projects/<project-key>.md"
]
write = [
  "projects/<project-key>.md"
]
guarded_write = [
  "config.toml",
  ".pamem/config.toml",
  "roles/onboarding/onboarding.md",
  "roles/onboarding/experience.md"
]
