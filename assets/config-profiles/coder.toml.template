# pamem shared config template for the coder profile
# Copy this file to .pamem/config.toml when the workspace should default to implementation work.
# Managed by a human or an onboarding-authorized profile. Ordinary task agents read it but do not rewrite it directly.

version = 1
default_profile = "coder"

[runtime]
# cli = local workspace recovery memory; slock = workspace task board owns task state and pamem only keeps durable memory.
mode = "cli"

[memory_repo]
# Relative paths are resolved from the agent workspace; absolute paths are allowed for a shared repo used by multiple agents.
path = ".pamem/memory"
sharing = "shared"
entry_file = "MEMORY.md"

[memory_repo.sync]
# local = no remote sync; git = private git repo; webdav = rclone remote:path
backend = "local"
remote = ""
ref = "main"
sync_bootstrapped = false

[governance]
config_owner = "human"
generated_by = "onboarding"
requires_review_for = [
  "memory_repo",
  "memory_repo.sync",
  ".pamem/config.toml",
  "L0/**",
  "L1/shared/**",
  "L1/roles/**"
]

[sync]
queue_root = ".pamem/sync-queue"
executor = "<configured-sync-executor>"
policy = "explicit_request_or_workspace_policy"

[profiles.coder]
role = "coder"
description = "Implementation profile for code changes and task execution."
load = [
  "L0/constitution.md",
  "L1/shared/preferences.md",
  "L1/shared/operating-rules.md",
  "L1/shared/experience.md",
  "L1/roles/coder.md",
  "L2/projects/<project-key>.md"
]
write = [
  "L2/projects/<project-key>.md",
  "requests/inbox/"
]
guarded_write = [
  "L1/roles/coder.md"
]
