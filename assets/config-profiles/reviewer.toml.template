# pamem shared config template for the reviewer profile
# Copy this file to config.toml for an XDG agent home, or to .pamem/config.toml when a legacy workspace should default to review work.
# Managed by a human or an onboarding-authorized profile. Ordinary task agents read it but do not rewrite it directly.

version = 1
default_profile = "reviewer"

[runtime]
# cli = current-task is primary local recovery; slock = task board owns state while workspace notes keep a thin current-task/work-log cache.
mode = "cli"
# Optional stable id for the local agent home. Empty means derive from the configured root path.
agent_id = ""

[runtime.resume]
# Optional runtime-native resume launcher, e.g. ["codex", "resume"].
# Empty means pamem launch --resume falls back to the launcher recorded by pamem launch.
command = []

[memory_repo]
# Default is a machine-level shared memory repo. Bootstrap initializes this path as a git repository. Relative paths are resolved from the agent home or legacy workspace when an override is needed.
path = "${XDG_DATA_HOME:-$HOME/.local/share}/pamem/memory"
sharing = "shared"
entry_file = "MEMORY.md"

[memory_repo.sync]
# Git-only sync. Empty remote means use the repo's origin remote.
remote = ""
ref = "main"

[governance]
config_owner = "human"
generated_by = "onboarding"
requires_review_for = [
  "memory_repo",
  "memory_repo.sync",
  "config.toml",
  ".pamem/config.toml",
  "governance/**",
  "shared/**",
  "roles/**"
]

[sync]
queue_root = ".pamem/sync-queue"
executor = "<configured-sync-executor>"
policy = "explicit_request_or_workspace_policy"

[profiles.reviewer]
role = "reviewer"
description = "Review profile for validation, critique, and change risk analysis."
load = [
  "governance/constitution.md",
  "shared/preferences.md",
  "shared/operating-rules.md",
  "shared/experience.md",
  "roles/reviewer/reviewer.md",
  "projects/<project-key>.md"
]
write = [
  "requests/inbox/"
]
guarded_write = []
