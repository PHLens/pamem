# pamem shared config template for the wiki profile
# Copy this file to config.toml for an XDG agent home, or to .pamem/config.toml when a legacy workspace should default to wiki curation work.
# Managed by a human or an onboarding-authorized profile. Ordinary task agents read it but do not rewrite it directly.

version = 1
default_profile = "wiki"

[runtime]
# cli = current-task is primary local recovery; slock = task board owns state while workspace notes keep a thin current-task/work-log cache.
mode = "cli"
# Optional stable id for the local agent home. Empty means derive from the configured root path.
agent_id = ""

[runtime.resume]
# Optional runtime-native resume launcher, e.g. ["codex", "resume"].
# Empty means pamem resume falls back to the launcher recorded by pamem start.
command = []

[memory_repo]
# Default is a machine-level shared memory repo. Relative paths are resolved from the agent home or legacy workspace when an override is needed.
path = "${XDG_DATA_HOME:-$HOME/.local/share}/pamem/memory"
sharing = "shared"
entry_file = "MEMORY.md"

[memory_repo.sync]
# local = no remote sync; git = private git repo; webdav = rclone remote:path
backend = "local"
remote = ""
ref = "main"
sync_bootstrapped = false

[governance]
config_owner = "human"
generated_by = "onboarding"
requires_review_for = [
  "memory_repo",
  "memory_repo.sync",
  "config.toml",
  ".pamem/config.toml",
  "L0/**",
  "L1/shared/**",
  "L1/roles/**"
]

[sync]
queue_root = ".pamem/sync-queue"
executor = "<configured-sync-executor>"
policy = "explicit_request_or_workspace_policy"

[profiles.wiki]
role = "wiki"
description = "Wiki profile for curation workflow, knowledge pointers, and sync handoffs."
load = [
  "L0/constitution.md",
  "L1/shared/preferences.md",
  "L1/shared/operating-rules.md",
  "L1/shared/experience.md",
  "L1/roles/wiki/index.md",
  "L2/projects/<project-key>.md"
]
write = [
  "requests/inbox/"
]
guarded_write = []
