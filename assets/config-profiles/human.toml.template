# pamem shared config template for the human review profile
# Copy this file to .pamem/config.toml when the workspace should default to human review.
# Managed by a human or an onboarding-authorized profile. Ordinary task agents read it but do not rewrite it directly.

version = 1
default_profile = "human"

[memory_repo]
# Relative paths are resolved from the agent workspace; absolute paths are allowed for a shared repo used by multiple agents.
path = ".pamem/memory"
sharing = "shared"
layout = "L0/L1/L2/L3"
entry_file = "MEMORY.md"

[memory_repo.sync]
# local = no remote sync; git = private git repo; webdav = rclone remote:path
backend = "local"
remote = ""
ref = "main"
sync_bootstrapped = false

[governance]
config_owner = "human"
generated_by = "onboarding"
requires_review_for = [
  "memory_repo",
  "memory_repo.sync",
  ".pamem/config.toml",
  "L0/**",
  "L1/shared/**",
  "L1/roles/**"
]

[sync]
queue_root = ".pamem/sync-queue"
executor = "<configured-sync-executor>"
policy = "explicit_request_or_workspace_policy"

[profiles.human]
role = "human"
description = "Human review profile for approving governance and config changes."
load = [
  "L0/constitution.md",
  "L1/shared/preferences.md",
  "L1/shared/operating-rules.md",
  "L1/shared/experience.md"
]
write = [
  ".pamem/config.toml",
  "requests/inbox/",
  "L1/shared/experience.md",
  "L1/roles/onboarding.md"
]
guarded_write = [
  "L0/constitution.md",
  "L1/shared/preferences.md",
  "L1/shared/operating-rules.md",
  "L1/shared/experience.md",
  "L1/roles/onboarding.md"
]
